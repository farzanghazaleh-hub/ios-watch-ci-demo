default_platform(:ios)

platform :ios do
  desc "İmzasız archive: iPhone uygulaması + gömülü Apple Watch uygulaması"
  lane :build_unsigned do
    build_app(
      project: "WatchDemo.xcodeproj",
      scheme: "WatchDemo",
      configuration: "Release",
      destination: "generic/platform=iOS",
      skip_codesigning: true,
      skip_package_ipa: true,
      archive_path: "build/WatchDemo.xcarchive",
      xcargs: "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO",
      xcodebuild_formatter: "xcbeautify"
    )
  end
end
